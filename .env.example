# Copy to .env (gitignored). Never commit real values.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# anthropic = real Claude models | scripted = offline replay (no key, no cost)
LLM_MODE=anthropic
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_HAIKU=claude-haiku-5-5

# --- HTTP API ------------------------------------------------------------
# Bearer token for `aecom api` (all routes except /health and the AgentMail webhook).
# Unset = protected routes return 503. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AECOM_API_TOKEN=

# --- Dashboard -----------------------------------------------------------
# Login for `aecom dashboard` (approvals, kill switch). Unset = dashboard shows only setup instructions.
# Generate the line with: uv run python -m aecom.dashboard_auth   (format: scrypt$<salt_hex>$<hash_hex>)
DASHBOARD_PASSWORD_HASH=
# DASHBOARD_AUTH=off disables the login (local development only; the dashboard shows a warning banner)
# DASHBOARD_AUTH=off

# --- Data --------------------------------------------------------------
# default: sqlite file in ./data ; Postgres via docker-compose:
# DATABASE_URL=postgresql+psycopg://aecom:aecom@localhost:5432/aecom

# --- AgentMail (https://docs.agentmail.to) -------------------------------
# Use a dedicated key (`aecom agentmail create-key aecom-poc`), not an org-wide full-access PAT.
AGENTMAIL_API_KEY=
AGENTMAIL_ORG_INBOX=enrgy@agentmail.to
# false = emails stay in the local outbox (dashboard) ; true = really send
AGENTMAIL_LIVE=false
# Signing secret (whsec_...) of the AgentMail webhook pointed at POST /webhooks/agentmail; unset = webhook rejected (503)
AGENTMAIL_WEBHOOK_SECRET=

# --- Store ---------------------------------------------------------------
# mock until the CEO's platform decision is provisioned by a human; lemonsqueezy = Lemon Squeezy is the system of
# record (checkout, payment, VAT as merchant of record, licence keys, downloads, refunds) and the app mirrors it
STORE_ADAPTER=mock

# --- Lemon Squeezy (STORE_ADAPTER=lemonsqueezy; https://docs.lemonsqueezy.com/api) ----------------------
# A human creates these in the Lemon Squeezy dashboard (agents never sign up or handle keys; request_provisioning).
# API key: Settings > API. Used for catalog sync (products/variants) and refunds.
LEMONSQUEEZY_API_KEY=
# Numeric store id (Settings > Stores); catalog sync only reads this store's products
LEMONSQUEEZY_STORE_ID=
# Signing secret of the webhook (Settings > Webhooks; events order_created, order_refunded, license_key_created,
# license_key_updated). Each delivery is checked against its X-Signature header (HMAC-SHA256); unset = rejected.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Store currency the ledger books in; orders in another currency are refused, not converted
# LEMONSQUEEZY_CURRENCY=EUR

# --- Credentials requested by the CEO via request_provisioning ------------
# GOOGLE_ADS_REFRESH_TOKEN=

# --- Observability (optional) ----------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aecom
# Error tracking: unexpected errors are always stored in ops_errors (secrets masked). Set a Sentry DSN to also
# forward them to Sentry; needs the optional extra: `uv sync --extra observability`. Empty = local only.
SENTRY_DSN=

# --- Alerting (optional; every channel is a no-op when unset) -----------------
# Monitors run every 5 min in `aecom scheduler`. P1 -> phone push + email, P2 -> email, P3 -> daily flash digest.
# Phone push via ntfy (https://ntfy.sh or self-hosted): full topic URL. Pick an unguessable topic name; the URL is
# effectively a secret. Subscribe to the same topic in the ntfy phone app.
NTFY_URL=
# Access token for a protected ntfy topic (sent as Bearer). Empty = public topic.
NTFY_TOKEN=
# Recipient of P1/P2 alert emails, sent via AgentMail (stays in the local outbox unless AGENTMAIL_LIVE=true).
ALERT_EMAIL=
# Recipient of the daily flash (07:00: yesterday's numbers, Finance commentary, open P2/P3 incidents digest).
# Empty = sent to ALERT_EMAIL; neither set = the flash is only stored as a report.
REPORT_EMAIL=
# External dead-man's switch (e.g. https://hc-ping.com/<uuid> from healthchecks.io). Pinged after every monitor
# run, so if the Pi, the scheduler or the network dies, that service alerts you. Set its period to 5 min, grace 10 min.
HEALTHCHECKS_PING_URL=

# --- Backups (aecom backup; see docs/wiki/Backups.md) -----------------------------------------
# BACKUP_DIR=data/backups
# Off-device copy after every backup: a local path (mounted USB drive) or user@host:/path (rsync over ssh).
# Backups contain customer personal data: use a trusted, encrypted target. Never put .env in backups.
# BACKUP_TARGET=/mnt/usb/aecom-backups

# --- Migration reminder -----------------------------------------------------------------------
# EUR of cumulative net revenue from REAL store sales that triggers a one-time reminder to review the move
# from the Raspberry Pi to a cloud server and to adopt an accounting tool (lexoffice or sevDesk).
# MIGRATION_REVENUE_EUR=25

# --- Autonomy (see docs/wiki/Autonomy.md) -----------------------------------------------------
# Evidence a human needs before an action can be promoted to a higher stage. Defaults shown.
# AUTONOMY_MIN_REAL_SALES=10
# AUTONOMY_MIN_DECISIONS=20
# AUTONOMY_MIN_UNCHANGED_RATE=0.95
# AUTONOMY_COOLDOWN_DAYS=14
