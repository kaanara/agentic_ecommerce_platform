# Copy to .env (gitignored). Never commit real values.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# anthropic = real Claude models | scripted = offline replay (no key, no cost)
LLM_MODE=anthropic
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_HAIKU=claude-haiku-5-5

# --- Data --------------------------------------------------------------
# default: sqlite file in ./data ; Postgres via docker-compose:
# DATABASE_URL=postgresql+psycopg://aecom:aecom@localhost:5432/aecom

# --- AgentMail (https://docs.agentmail.to) -------------------------------
# Use a dedicated key (`aecom agentmail create-key aecom-poc`), not an org-wide full-access PAT.
AGENTMAIL_API_KEY=
AGENTMAIL_ORG_INBOX=enrgy@agentmail.to
# false = emails stay in the local outbox (dashboard) ; true = really send
AGENTMAIL_LIVE=false

# --- Store ---------------------------------------------------------------
# mock until the CEO's platform decision is provisioned by a human
STORE_ADAPTER=mock

# --- Credentials requested by the CEO via request_provisioning ------------
# LEMONSQUEEZY_API_KEY=
# GOOGLE_ADS_REFRESH_TOKEN=

# --- Observability (optional) ----------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aecom
